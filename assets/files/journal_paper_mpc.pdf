         <dc:format>application/pdf</dc:format>
         <dc:subject>
            <rdf:Bag>
               <rdf:li>Constrained control</rdf:li>
               <rdf:li>deep neural network (DNN)</rdf:li>
               <rdf:li>FPGA deployment</rdf:li>
               <rdf:li>high-precision motion control</rdf:li>
               <rdf:li>magnetic levitation</rdf:li>
               <rdf:li>model predictive control (MPC)</rdf:li>
            </rdf:Bag>
         </dc:subject>
         <dc:creator>
            <rdf:Seq>
               <rdf:li>Chang Hwan Kim</rdf:li>
               <rdf:li>Jung Jun Kim</rdf:li>
               <rdf:li>Hyeong Min Yoon</rdf:li>
               <rdf:li>Jun Young Yoon</rdf:li>
            </rdf:Seq>
         </dc:creator>
         <dc:publisher>
            <rdf:Bag>
               <rdf:li>IEEE</rdf:li>
            </rdf:Bag>
         </dc:publisher>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">DNN-Approximated Offset-Free MPC on FPGA for 10-khz Constrained In-Plane Control of 6-DOF Magnetic Levitation System</rdf:li>
            </rdf:Alt>
         </dc:title>
